  "cards": [
    {
      "dot": "cyan",
      "title": "Read path",
      "items": [
        "The server collects the resource group and diffs it against the previous snapshot",
        "sbw reads /api/v1 over HTTPS with X-Sandbox-Token",
        "The server bounds that token to Reader: holding it changes nothing"
      ]
    },
    {
      "dot": "emerald",
      "title": "Write path — batch 3",
      "items": [
        "start / stop / restart go through the local az CLI",
        "Under your own Azure login, never the sandbox token",
        "Three guards: subscription, snapshot freshness, non-interactivity",
        "Dashed boxes are designed, not present in Sources/"
      ]
    },
    {
      "dot": "rose",
      "title": "State on disk",
      "items": [
        "The inventory and the change cursors hold no secret",
        "The token lives only in the Keychain — never in YAML, never as an argument"
      ]
    }
  ]
